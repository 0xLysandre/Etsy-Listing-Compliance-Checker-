# Database
DATABASE_URL="postgresql://username:password@localhost:5432/etsy_compliance?schema=public"

# Prisma (NixOS workaround - uncomment if on NixOS)
# PRISMA_QUERY_ENGINE_LIBRARY=/nix/store/.../libquery_engine.so
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Email (Resend API - https://resend.com)
# Leave empty for development mode (emails will be logged to console)
RESEND_API_KEY=""
EMAIL_FROM="noreply@your-domain.com"
FRONTEND_URL="http://localhost:5173"

# JWT Refresh Token (optional - defaults to JWT_SECRET)
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
