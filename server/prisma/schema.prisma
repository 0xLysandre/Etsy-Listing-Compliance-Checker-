// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum definitions
enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// User model - stores user authentication and subscription info
model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String             @map("password_hash")
  subscriptionTier   SubscriptionTier   @default(FREE) @map("subscription_tier")
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  stripeCustomerId   String?            @unique @map("stripe_customer_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  listings Listing[]

  @@map("users")
}

// Listing model - stores Etsy product listings for compliance checking
model Listing {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String   @db.Text
  tags        String[] // Array of tags
  category    String
  price       Decimal  @db.Decimal(10, 2)
  materials   String[] // Array of materials
  imageUrls   String[] @map("image_urls")
  etsyUrl     String?  @map("etsy_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  violationChecks ViolationCheck[]

  @@index([userId])
  @@map("listings")
}

// PolicyRule model - stores Etsy policy rules for compliance checking
model PolicyRule {
  id        String   @id @default(cuid())
  category  String   // e.g., "prohibited_items", "intellectual_property", "listing_requirements"
  ruleName  String   @map("rule_name")
  ruleText  String   @db.Text @map("rule_text")
  severity  Severity
  keywords  String[] // Keywords that trigger this rule
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  violations Violation[]

  @@index([category])
  @@index([severity])
  @@map("policy_rules")
}

// ViolationCheck model - stores the results of compliance checks on listings
model ViolationCheck {
  id              String      @id @default(cuid())
  listingId       String      @map("listing_id")
  checkDate       DateTime    @default(now()) @map("check_date")
  violationsFound Int         @default(0) @map("violations_found")
  status          CheckStatus @default(PENDING)
  completedAt     DateTime?   @map("completed_at")

  // Relations
  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  violations Violation[]

  @@index([listingId])
  @@index([checkDate])
  @@map("violation_checks")
}

// Violation model - stores individual violations found during checks
model Violation {
  id            String   @id @default(cuid())
  checkId       String   @map("check_id")
  policyRuleId  String   @map("policy_rule_id")
  violationText String   @db.Text @map("violation_text")
  severity      Severity
  suggestion    String   @db.Text // Suggested fix for the violation
  matchedText   String?  @db.Text @map("matched_text") // The actual text that triggered the violation
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  check      ViolationCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  policyRule PolicyRule     @relation(fields: [policyRuleId], references: [id])

  @@index([checkId])
  @@index([policyRuleId])
  @@map("violations")
}
